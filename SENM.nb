       RowBox[{"Sinh", "[", 
        SubscriptBox["\[Kappa]", "g"], "]"}], 
       SubscriptBox["\[Kappa]", "g"]]}], ")"}]}], "+", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
