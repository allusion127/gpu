Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["\[Phi]", "g"], "[", 
   RowBox[{"x_", ",", "A_", ",", "B_"}], "]"}], ":=", 
  RowBox[{
   SubscriptBox[
    OverscriptBox["\[Phi]", "_"], "g"], "+", 
