Cell[BoxData[
 RowBox[{"sol", "=", 
  RowBox[{
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "/", 
           RowBox[{
            SubscriptBox["\[Kappa]", "g"], "^", "2"}]}], ")"}]}], "*", 
        RowBox[{
         RowBox[{"y", "''"}], "[", "x", "]"}]}], "+", 
       RowBox[{"y", "[", "x", "]"}]}], "==", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "4"], 
       RowBox[{
        SubscriptBox["q", 
         RowBox[{"g", ",", "i"}]], "*", 
        RowBox[{
         RowBox[{"LegendreP", "[", 
          RowBox[{"i", ",", "x"}], "]"}], "/", 
         SubscriptBox["\[CapitalSigma]", "g"]}]}]}]}], ",", 
     RowBox[{"y", "[", "x", "]"}], ",", "x"}], "]"}], "//", 
   "ExpToTrig"}]}]], "Input",
