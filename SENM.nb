Cell["\<\
Suppose that all the homogeneous solution coefficients are determined.
Then, the flux shape involving the sinh and cosh functions an be approximated \
using a quartic polynomial.\
\>", "Text",
 CellChangeTimes->{{3.936306391653124*^9, 
  3.9363064369778767`*^9}},ExpressionUUID->"61c7859d-9c54-af48-a052-\
4c5a29a4f0ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Phi]", "[", 
   RowBox[{"x_", ",", "a_", ",", "b_", ",", "c_", ",", "d_", ",", "e_"}], 
   "]"}], ":=", 
  RowBox[{
   RowBox[{"A", "*", 
    RowBox[{"Sinh", "[", 
     RowBox[{
      SubscriptBox["\[Kappa]", "g"], "*", "x"}], "]"}]}], "+", 
