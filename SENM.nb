    RowBox[{"Cosh", "[", 
     RowBox[{
      SubscriptBox["\[Kappa]", "g"], "*", "x"}], "]"}]}], "+", 
   RowBox[{"a", "*", 
    RowBox[{"LegendreP", "[", 
     RowBox[{"0", ",", "x"}], "]"}]}], "+", 
   RowBox[{"b", "*", 
    RowBox[{"LegendreP", "[", 
     RowBox[{"1", ",", "x"}], "]"}]}], "+", 
   RowBox[{"c", "*", 
    RowBox[{"LegendreP", "[", 
     RowBox[{"2", ",", "x"}], "]"}]}], "+", 
   RowBox[{"d", "*", 
    RowBox[{"LegendreP", "[", 
     RowBox[{"3", ",", "x"}], "]"}]}], "+", 
   RowBox[{"e", "*", 
    RowBox[{"LegendreP", "[", 
     RowBox[{"4", ",", "x"}], "]"}]}]}]}]], "Input",
