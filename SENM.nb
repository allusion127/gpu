Cell[CellGroupData[{

Cell["\<\
Flux Expansion with Quartic Polynomial and Exponential Functions\
\>", "Chapter",
 CellChangeTimes->{{3.936823319180172*^9, 
  3.936823345900009*^9}},ExpressionUUID->"4eac15f6-b516-2642-8b04-\
a8f65463b5fd"],

Cell[CellGroupData[{

Cell["1. Basis Function and their Properties", "Subsection",
 CellChangeTimes->{{3.9368233503163376`*^9, 
  3.9368233570904503`*^9}},ExpressionUUID->"b92d5f55-15ee-824c-8bec-\
fc37562300ff"],

Cell[TextData[{
 "As first introduced by Hennart, it is convenient to redefine the basis \
functions with sinh and cosh functions, s.t. they satisfy the condition of \
orthogonality with Legendre polynomials and the unity boundary value.\nSince \
the new basis is group-dependent, it is necessary to generalize the basis \
functions s.t. all of them have group dependence. Therefore, the following \
constraints must be satisfied for all ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "gi"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "54a4104d-08bf-e44b-af9f-978a5a8ec7fa"]
}], "Text",
 CellChangeTimes->{{3.9368233692919483`*^9, 
  3.936823503677082*^9}},ExpressionUUID->"fc85f1ea-e68a-ca4a-bf75-\
956d98e446f4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "1"}], "1"], 
    RowBox[{
     RowBox[{
      SubscriptBox["P", 
       RowBox[{"g", ",", "i"}]], " ", "[", "x", "]"}], "*", 
     RowBox[{
      SubscriptBox["P", 
       RowBox[{"g", ",", "j"}]], "[", "x", "]"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], "==", "0"}], ",", " ", 
  RowBox[{"0", "<=", "i", "<=", "4"}], ",", 
  RowBox[{"5", "<=", "j", "<=", "6"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["P", 
     RowBox[{"g", ",", "5"}]], "[", 
    RowBox[{"\[PlusMinus]", "1"}], "]"}], "==", 
   RowBox[{"\[PlusMinus]", "1"}]}], ",", " ", 
  RowBox[{
   RowBox[{
    SubscriptBox["P", 
     RowBox[{"g", ",", "6"}]], "[", 
    RowBox[{"\[PlusMinus]", "1"}], "]"}], "==", "1"}]}]}], "Input",
 CellChangeTimes->{{3.936823512624405*^9, 3.936823601884775*^9}},
 CellLabel->
  "In[628]:=",ExpressionUUID->"98a6bb17-f58a-0c4b-bb23-4c6da804f1dd"],

