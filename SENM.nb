        SubscriptBox["m", 
         RowBox[{"g", ",", "2"}]], "+", 
        SubscriptBox["m", 
         RowBox[{"g", ",", "4"}]]}]], "0", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"-", "6"}], " ", 
         RowBox[{"Cosh", "[", 
          SubscriptBox["\[Kappa]", "g"], "]"}], " ", 
         SubscriptBox["\[Kappa]", "g"]}], "+", 
        RowBox[{"2", " ", 
         RowBox[{"Sinh", "[", 
          SubscriptBox["\[Kappa]", "g"], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{"3", "+", 
           SubsuperscriptBox["\[Kappa]", "g", "2"]}], ")"}]}], "+", 
        RowBox[{"14", " ", 
         SubscriptBox["\[Kappa]", "g"], " ", 
         SubscriptBox["m", 
          RowBox[{"g", ",", "4"}]]}]}], 
       RowBox[{
        SubscriptBox["\[Kappa]", "g"], " ", 
        RowBox[{"(", 
