  3.9368250116976604`*^9, 3.9368250159270153`*^9}},
 CellLabel->
  "In[634]:=",ExpressionUUID->"0df32c25-3336-9b4e-a17d-2b12811d4cf5"],

Cell[TextData[{
 "And the equation can be satisfied by choosing the free parameters, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", 
    RowBox[{"g", ",", "i"}]], TraditionalForm]],ExpressionUUID->
  "9515ef18-f0b9-b84f-89e9-3bcd57bc6678"],
 " s, as follows:"
}], "Text",
 CellChangeTimes->{{3.9368241565251613`*^9, 3.936824175143066*^9}, {
  3.9368402379431553`*^9, 
  3.93684023902705*^9}},ExpressionUUID->"691791e6-c8af-af48-9bd9-\
a9c27ba7c89c"],

