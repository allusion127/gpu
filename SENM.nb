Cell[TextData[{
 "By applying the WRM with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "0"], ",", 
    RowBox[{
     SubscriptBox["P", "2"], " ", "and", " ", 
     SubscriptBox["P", "4"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f567bcdc-8f87-ac49-9e09-3c1f981d79e6"],
 " to Equation, the following relations are obtained. The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"D", " ", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "1"}], "1"], 
     RowBox[{
      RowBox[{"\[CapitalPhi]", "''"}], 
      RowBox[{"(", "\[Xi]", ")"}], 
      RowBox[{
       SubscriptBox["P", "i"], "(", "\[Xi]", ")"}], "d\[Xi]"}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ab512d34-5252-f544-8869-43b9d0cfece9"],
 " terms, for i=0, 2 and 4:"
}], "Text",
 CellChangeTimes->{{3.937001634029604*^9, 3.9370017038988304`*^9}, {
  3.937001889562254*^9, 
  3.937001925664074*^9}},ExpressionUUID->"7515a353-b0b8-634a-be54-\
583bebc75e0f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Collect", "[", 
      RowBox[{
       RowBox[{"DD", ".", 
        RowBox[{
         SubsuperscriptBox["\[Integral]", 
          RowBox[{"-", "1"}], "1"], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"PHI", "[", "x", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "*", 
            RowBox[{
             SubscriptBox["P", 
              RowBox[{"g", ",", "0"}]], "[", "x", "]"}]}], ")"}], 
          RowBox[{"\[DifferentialD]", "x"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          SubscriptBox["c", 
           RowBox[{"i", ",", "j"}]], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", "6"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", "6"}], "}"}]}], "]"}], "//", 
        "Flatten"}]}], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{" ", 
          RowBox[{
           RowBox[{
            RowBox[{"Sinh", "[", 
             SubscriptBox["\[Kappa]", "g"], "]"}], " ", 
            SubscriptBox["\[Kappa]", "g"]}], "+", 
           RowBox[{"3", " ", 
            SubscriptBox["m", 
             RowBox[{"g", ",", "2"}]]}], "+", 
           RowBox[{"10", " ", 
            SubscriptBox["m", 
             RowBox[{"g", ",", "4"}]]}]}]}], 
         RowBox[{
          RowBox[{"Cosh", "[", 
           SubscriptBox["\[Kappa]", "g"], "]"}], "+", 
          SubscriptBox["m", 
           RowBox[{"g", ",", "0"}]], "+", 
          SubscriptBox["m", 
           RowBox[{"g", ",", "2"}]], "+", 
          SubscriptBox["m", 
           RowBox[{"g", ",", "4"}]]}]], "->", 
        RowBox[{
         SubscriptBox["k", 
          RowBox[{"6", ",", "0"}]], "/", "2"}]}], ",", 
       RowBox[{"20", "->", 
        SubscriptBox["k", 
         RowBox[{"4", ",", "0"}]]}], ",", 
       RowBox[{"6", "->", 
        SubscriptBox["k", 
         RowBox[{"2", ",", "0"}]]}]}], "}"}]}], ")"}], "*", 
   RowBox[{"(", 
    RowBox[{"4", "/", 
     RowBox[{"h", "^", "2"}]}], ")"}]}], "//", "MatrixForm"}]], "Input",
